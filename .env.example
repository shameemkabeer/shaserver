# Copy to .env (install.sh does this for you). No secrets live here:
# the admin password hash and tokens are generated at runtime in ./data.
PIBOARD_HOME=/home/youruser/piboard
PIBOARD_PORT=8088
LOCAL_IP=127.0.0.1
TAILSCALE_IP=100.x.y.z
PUID=1000
PGID=1000
DOCKER_GID=985
TZ=UTC
# Screensaver weather location (Open-Meteo, no API key). Set your own coordinates.
#WEATHER_LAT=24.21
#WEATHER_LON=55.74
